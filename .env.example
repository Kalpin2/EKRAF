# MySQL (docker compose default)
DATABASE_URL="mysql://nexus:nexus_secret@localhost:3306/nexus_esports"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Encryption (AES-256-GCM) — 32-byte hex key
ENCRYPTION_KEY="000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"

# API
API_PORT="4000"
WEB_ORIGIN="http://localhost:5173"

# Demo accounts (dipakai seed API + halaman login web)
DEMO_ADMIN_EMAIL="admin@nexus.gg"
DEMO_MANAGER_EMAIL="manager@nexus.gg"
DEMO_PLAYER_EMAIL="player@nexus.gg"
DEMO_PASSWORD="nexus123"

# Frontend (apps/web/.env) — kredensial login demo & default role
VITE_API_URL="http://localhost:4000/api"
VITE_DEMO_ADMIN_EMAIL="admin@nexus.gg"
VITE_DEMO_ADMIN_PASSWORD="nexus123"
VITE_DEMO_MANAGER_EMAIL="manager@nexus.gg"
VITE_DEMO_MANAGER_PASSWORD="nexus123"
VITE_DEMO_PLAYER_EMAIL="player@nexus.gg"
VITE_DEMO_PLAYER_PASSWORD="nexus123"
VITE_DEMO_DEFAULT_ROLE="player"
