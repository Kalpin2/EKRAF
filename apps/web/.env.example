# Standalone demo frontend — copy ke .env lalu sesuaikan jika perlu.
# Tidak perlu backend/API/database; semua data dari mock lokal.

# Tier Admin / Manager — masuk ke /dashboard
VITE_ADMIN_USERNAME=admin@nexus.gg
VITE_ADMIN_PASSWORD=nexus123

# Tier Player — masuk ke /player/dashboard
VITE_PLAYER_USERNAME=player@nexus.gg
VITE_PLAYER_PASSWORD=nexus123

# Selalu true untuk standalone demo
VITE_DEMO_MODE=true

# Opsional, hanya untuk mode hybrid (API live)
VITE_API_URL=http://localhost:4000/api
